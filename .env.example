# =============================================================================
# Everything here is read at runtime, on the server only.
# =============================================================================

# PostgreSQL. Used only by src/server/db.ts, which is marked "server-only":
# if it ever gets pulled into a client component the build fails rather
# than the credentials shipping to a browser.
#
# Local Homebrew Postgres:   postgres://localhost:5432/ifmp
# With a user and password:  postgres://ifmp:<password>@localhost:5432/ifmp
# Fresh empty database:     npm run db:setup
# Existing database:        npm run db:upgrade (back up first)
# (docker compose sets its own DATABASE_URL pointing at the `db` service.)
DATABASE_URL=postgres://localhost:5432/ifmp
# DATABASE_POOL_MAX=10

# TLS, for the deployed portal (the `proxy` container).
# Paths ON THE HOST to the certificate and key the institute supplied.
# The certificate file must be the full chain if they gave you one.
SSL_CERT_FILE=/home/<user>/portal.crt
SSL_KEY_FILE=/home/<user>/portal.key

# The password for the `db` container. Generate one:
#   openssl rand -hex 24
# Use hex, or any password without '/', '@', ':' or '#': this value is
# interpolated into the connection URL, and those characters make it
# unparseable. docker compose refuses to start without it.
POSTGRES_PASSWORD=<generated-password>

# NextAuth. NEXTAUTH_URL must be the public URL of the deployment -- it is
# also what the notification emails link back to.
# Must match exactly how people reach the portal, including the port.
# On the institute server: https://172.22.100.12:8116
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<generate with: openssl rand -base64 32>

# -----------------------------------------------------------------------------
# LDAP -- the institute directory, reachable only from the IIT Mandi network.
# LDAP proves who somebody is; their ROLE always comes from the employees
# table, never from LDAP and never from the login form.
# -----------------------------------------------------------------------------
LDAP_URL=ldaps://<ldap-host>:636
LDAP_BASE_DN=dc=iitmandi,dc=ac,dc=in
OU=["students_ug","Faculty","Staff"]

# The older names for the two settings above are still read as a fallback.
# `URL` in particular is a poor choice of variable name -- prefer LDAP_URL.
# URL=ldap://<ldap-host>:389
# BaseDN=dc=iitmandi,dc=ac,dc=in

# Demo login is retained for this branch. Local development defaults to password
# 123 unless disabled. Production requires BOTH explicit enablement and a password.
# These accounts include Dean: do not enable on a live financial deployment.
# DEMO_LOGIN_ENABLED=true
# DEMO_PASSWORD=<shared-demo-password>
# See README.md for the optional, non-destructive demo account seed.

# -----------------------------------------------------------------------------
# Outbound mail -- the "Notify User" step in architecture.jpeg.
# The applicant is emailed when a bill is rejected, put on hold, or finally
# approved.
# -----------------------------------------------------------------------------
EMAIL=<sender@gmail.com>
EMAIL_PASSWORD=<gmail-app-password>

# Optional non-production mail redirection; leave blank in production.
# MAIL_REDIRECT_TO=

# Set to false to skip sending mail altogether (decisions are still logged).
MAIL_ENABLED=true
