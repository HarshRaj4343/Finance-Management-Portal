# =============================================================================
# BUILD-TIME (compiled into the browser bundle -- must be passed to
# `docker build --build-arg`, not just at runtime)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# =============================================================================
# RUNTIME (server-side only -- pass with `docker run --env-file`)
# =============================================================================

# Supabase service role (bypasses RLS; server-side only)
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# NextAuth -- NEXTAUTH_URL must be the public URL of the deployment
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<generate with: openssl rand -base64 32>

# LDAP (institute directory; reachable only from the IIT Mandi network/VPN)
URL=ldap://<ldap-host>:389
BaseDN=dc=iitmandi,dc=ac,dc=in
OU=["students_ug","Faculty","Staff"]

# Gmail SMTP for bill notification emails
EMAIL=<sender@gmail.com>
EMAIL_PASSWORD=<gmail-app-password>
