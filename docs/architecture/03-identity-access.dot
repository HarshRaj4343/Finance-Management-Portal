digraph architecture {
graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica", fontsize=17, nodesep=0.34, ranksep=0.65, pad=0.25, splines=polyline, compound=true, newrank=true, outputorder=edgesfirst];
node [shape=plain, fontname="Helvetica", fontsize=13];
edge [fontname="Helvetica", fontsize=11, color="#64748b", fontcolor="#334155", arrowsize=0.7, penwidth=1.2];
credentials [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">/login credentials</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Username trimmed; both fields required</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Identifier whitelist, length 1-100</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">NextAuth credentials / CSRF flow</FONT></TD></TR></TABLE>>];
demo [shape=diamond, style=filled, fillcolor="#fff0d6", color="#a16207", fontcolor="#713f12", margin=0.12, label="Enabled demo\nusername?"];
democheck [label=<<TABLE BORDER="1" COLOR="#a16207" BGCOLOR="#fff0d6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#a16207" POINT-SIZE="16">Fixed demo password check</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Dean, Finance Admin, Audit, SNP</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Bill-form, Bill-edit, pda manager, User</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">E001-E008; exact fixed usernames</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Wrong demo password: reject, no fallback</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Development default 123; disable with false</FONT></TD></TR></TABLE>>];
ldapbind [label=<<TABLE BORDER="1" COLOR="#0e7490" BGCOLOR="#e4f5f8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#0e7490" POINT-SIZE="16">LDAP bind for each OU</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Default: students_ug, Faculty, Staff</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">DN: uid=username,ou=OU,baseDN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">5 s timeout / connect timeout</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">6 s fail-safe; unbind after result</FONT></TD></TR></TABLE>>];
employee [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">Load canonical employee</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Case-insensitive employee-code lookup</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Missing account: not provisioned</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Inactive account: deny sign-in</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Read role, department, name and email</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Database failures do not grant a fallback</FONT></TD></TR></TABLE>>];
jwt [label=<<TABLE BORDER="1" COLOR="#a16207" BGCOLOR="#fff0d6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#a16207" POINT-SIZE="16">JWT session</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Token + session maxAge 28,800 s</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">signedInAt enforces hard 8 h expiry</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Refresh live employee on session access</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Inactive / DB failure invalidate token</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">API currentActor rereads active employee</FONT></TD></TR></TABLE>>];
navigate [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Safe navigation</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">/ root -&gt; currentActor -&gt; role home</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Allow only safe local callback paths</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Reject external/backslash/control URLs</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Sign-out -&gt; /login</FONT></TD></TR></TABLE>>];
denied [label=<<TABLE BORDER="1" COLOR="#b91c1c" BGCOLOR="#ffe5e5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#b91c1c" POINT-SIZE="16">Access denied</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Bad credentials / absent / inactive</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Expired or unusable API session: 401</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Wrong permitted role/scope: 403</FONT></TD></TR></TABLE>>];
credentials -> demo [label=""];
demo -> democheck [label="Yes"];
demo -> ldapbind [label="No"];
democheck -> employee [label="correct"];
ldapbind -> employee [label="bound"];
employee -> jwt [label="active + provisioned"];
jwt -> navigate [label=""];
employee -> denied [label="otherwise", color="#b91c1c", fontcolor="#b91c1c"];
jwt -> denied [label="expired", color="#b91c1c", fontcolor="#b91c1c", constraint=false];
subgraph cluster_homes { label="LANDINGS AND SERVER CAPABILITIES"; style="rounded,filled"; color="#1d4ed8"; fillcolor="#e5efff40"; fontcolor="#1d4ed8"; margin=18;
u [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">User -&gt; /user</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Read own bills/register, lookup self</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">API: submit / held edit / note own bill</FONT></TD></TR></TABLE>>];
navigate -> u [label=""];
b [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Bill Employee -&gt; /apply-bill</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">File, held edit, note for own department</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Store &amp; Purchase Section: umbrella scope</FONT></TD></TR></TABLE>>];
navigate -> b [label=""];
e [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Bill Editor -&gt; /bill-editor</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Held edit + rejected note API, scoped</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Cannot submit new bills</FONT></TD></TR></TABLE>>];
navigate -> e [label=""];
s [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Student Purchase -&gt; /student-purchase</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Only decide bills at Store &amp; Purchase</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Read all bills; guarantee details on approve</FONT></TD></TR></TABLE>>];
navigate -> s [label=""];
a [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Audit -&gt; /audit</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Only decide bills currently at Audit</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Read all bills</FONT></TD></TR></TABLE>>];
navigate -> a [label=""];
f [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Finance Admin -&gt; /finance-admin</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Decide only at Finance Admin; PDA read</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Directory: create User, edit contacts</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Privileged role/active/department restricted</FONT></TD></TR></TABLE>>];
navigate -> f [label=""];
p [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">PDA Manager -&gt; /pda-manager</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Open / allocate / top up / close PDA</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">No bill filing or approval privilege</FONT></TD></TR></TABLE>>];
navigate -> p [label=""];
d [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Dean -&gt; /admin</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Directory, roles, active status, PDA</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Not a substitute bill approver/filer</FONT></TD></TR></TABLE>>];
navigate -> d [label=""];
}
}
