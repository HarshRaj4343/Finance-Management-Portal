digraph architecture {
graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica", fontsize=17, nodesep=0.34, ranksep=0.65, pad=0.25, splines=polyline, compound=true, newrank=true, outputorder=edgesfirst];
node [shape=plain, fontname="Helvetica", fontsize=13];
edge [fontname="Helvetica", fontsize=11, color="#64748b", fontcolor="#334155", arrowsize=0.7, penwidth=1.2];
browser [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Client helper / pages</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">api.get/post/patch/del -&gt; same-origin fetch</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">JSON content type; GET cache:no-store</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Returns {data,error}; Notice displays errors</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">api.bills follows 500-row cursor pages</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Failure on any page discards partial list</FONT></TD></TR></TABLE>>];
guards [label=<<TABLE BORDER="1" COLOR="#a16207" BGCOLOR="#fff0d6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#a16207" POINT-SIZE="16">Live server guards</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">requireActor / requireRole / requireApprover</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Active employee + database role</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Parameterised SQL; safe search literals</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Force-dynamic Node API routes</FONT></TD></TR></TABLE>>];
browser -> guards [label=""];
subgraph cluster_read { label="READ ENDPOINTS"; style="rounded,filled"; color="#6d28d9"; fillcolor="#eee9ff40"; fontcolor="#6d28d9"; margin=18;
me [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">GET /api/me</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Any actor: own identity, home, active PDA</FONT></TD></TR></TABLE>>];
guards -> me [label=""];
lookup [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">GET /api/lookup/employee</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">User: self only; staff: any active employee</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">code case-insensitive; profile=only omits PDA</FONT></TD></TR></TABLE>>];
guards -> lookup [label=""];
bills [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">GET /api/bills</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">User forced to own; non-User global read</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">employee/stage/status/category/department/q</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">limit/offset or timestamp|UUID cursor</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Stable created_at DESC, id DESC</FONT></TD></TR></TABLE>>];
guards -> bills [label=""];
detail [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">GET /api/bills/{id}</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">User owns bill; staff may read all</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Bill + events + applicant + register +</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">revisions</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Planned route computed for display</FONT></TD></TR></TABLE>>];
guards -> detail [label=""];
register [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">GET /api/register</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">User forced own purchases; staff global read</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">department/fy/from/to/q + limit/offset</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Rows/count/totals share exact WHERE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">All authorised FY choices + current IST FY</FONT></TD></TR></TABLE>>];
guards -> register [label=""];
employees [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">GET /api/admin/employees</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Dean/Finance only: directory + active PDA</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">q/role/department/active filters</FONT></TD></TR></TABLE>>];
guards -> employees [label=""];
pda [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">GET /api/admin/pda</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Dean/PDA Manager/Finance: active accounts</FONT></TD></TR></TABLE>>];
guards -> pda [label=""];
departments [label=<<TABLE BORDER="1" COLOR="#475569" BGCOLOR="#f1f5f9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#475569" POINT-SIZE="16">GET /api/departments</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Unguarded active department name/code lookup</FONT></TD></TR></TABLE>>];
browser -> departments [label="metadata", style="dashed", constraint=false];
}
writes [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">WRITE ENDPOINTS -&gt; SQL</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">POST /api/bills -&gt; fn_submit_bill</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">PATCH /api/bills/{id} -&gt; fn_amend_bill</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">POST /{id}/action -&gt; fn_bill_action</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">POST /{id}/note -&gt; fn_note_bill</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">POST employees; PATCH/DELETE /{code}</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">POST/PATCH/DELETE PDA -&gt; locked writes</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">GET/POST /api/auth/[...nextauth] -&gt; auth</FONT></TD></TR></TABLE>>];
guards -> writes [label="live permissions"];
subgraph cluster_detail { label="DETAIL / PRINT / QR READ-BACK"; style="rounded,filled"; color="#1d4ed8"; fillcolor="#e5efff40"; fontcolor="#1d4ed8"; margin=18;
page [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">/bill/{id}</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Structured items + current bill fields</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Desk route + events after correction</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Full timeline + before/after revision history</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Register details when finally approved</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Browser print; escaped BillCard print HTML</FONT></TD></TR></TABLE>>];
qr [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">QR link to current bill URL</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">react-qr-code generated in browser</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Not a payment QR or public token</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Scan -&gt; same bill URL -&gt; session check</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Sign-in callback returns to this record</FONT></TD></TR></TABLE>>];
detail -> page [label=""];
page -> qr [label=""];
qr -> guards [label="reopen, authenticate", style="dashed", constraint=false];
}
subgraph cluster_mail { label="POST-COMMIT NOTIFICATION / OPTIONAL"; style="rounded,filled"; color="#0e7490"; fillcolor="#e4f5f840"; fontcolor="#0e7490"; margin=18;
mailcheck [label=<<TABLE BORDER="1" COLOR="#0e7490" BGCOLOR="#e4f5f8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#0e7490" POINT-SIZE="16">Hold / Reject / final Accept</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Read bill and applicant&#x27;s current email</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">MAIL_ENABLED false -&gt; skip</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Missing mail credentials/email -&gt; skip</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Intermediate approval: no email</FONT></TD></TR></TABLE>>];
smtp [label=<<TABLE BORDER="1" COLOR="#0e7490" BGCOLOR="#e4f5f8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#0e7490" POINT-SIZE="16">Nodemailer Gmail send</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">EMAIL + EMAIL_PASSWORD configuration</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">MAIL_REDIRECT_TO can divert demo mail</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Escaped message fields + bill link</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Send errors logged, never rolled back</FONT></TD></TR></TABLE>>];
sent [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">After successful SMTP send</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Append System / Notified event</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">fn_log_event parent lock -&gt; next seq</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">No automatic retry / outbox guarantee</FONT></TD></TR></TABLE>>];
writes -> mailcheck [label="action result committed", style="dashed"];
mailcheck -> smtp [label="configured"];
smtp -> sent [label="sent"];
}
errors [label=<<TABLE BORDER="1" COLOR="#b91c1c" BGCOLOR="#ffe5e5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#b91c1c" POINT-SIZE="16">Error contract</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">401: missing/expired actor; 403: role/scope</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">400: rule, malformed data or constraints</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">404: bill record not found</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">409: duplicate / stale reviewed revision</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">503: missing schema; backup + upgrade</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">500: generic failure; details server-only</FONT></TD></TR></TABLE>>];
guards -> errors [label="failure", style="dashed", constraint=false];
}
