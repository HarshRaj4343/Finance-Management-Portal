digraph architecture {
graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica", fontsize=17, nodesep=0.34, ranksep=0.65, pad=0.25, splines=polyline, compound=true, newrank=true, outputorder=edgesfirst];
node [shape=plain, fontname="Helvetica", fontsize=13];
edge [fontname="Helvetica", fontsize=11, color="#64748b", fontcolor="#334155", arrowsize=0.7, penwidth=1.2];
subgraph cluster_wallet { label="PDA MONEY STATES - AMOUNT A / CORRECTION DELTA D"; style="rounded,filled"; color="#166534"; fillcolor="#dff5e940"; fontcolor="#166534"; margin=18;
allocate [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">Allocated funds</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Open: allocation = free balance</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Set total &gt;= committed + spent</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Top-up: allocation += positive amount</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Free = allocated - committed - spent</FONT></TD></TR></TABLE>>];
free [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">balance / free</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Available for the next purchase</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Cannot be used twice concurrently</FONT></TD></TR></TABLE>>];
committed [label=<<TABLE BORDER="1" COLOR="#92400e" BGCOLOR="#fff5cc" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#92400e" POINT-SIZE="16">committed / reserved</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Submit: free -= A; committed += A</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Amend: free -= D; committed += D</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Hold: unchanged</FONT></TD></TR></TABLE>>];
spent [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">spent / settled</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Accept: committed -= A; spent += A</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Free does not change at acceptance</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Register records the approved purchase</FONT></TD></TR></TABLE>>];
allocate -> free [label=""];
free -> committed [label="submit A"];
committed -> free [label="reject: release A", color="#b91c1c", fontcolor="#b91c1c", constraint=false];
committed -> spent [label="final accept A"];
}
subgraph cluster_pda { label="PDA ADMINISTRATION"; style="rounded,filled"; color="#6d28d9"; fillcolor="#eee9ff40"; fontcolor="#6d28d9"; margin=18;
read [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">GET /api/admin/pda</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Dean / PDA Manager / Finance Admin</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Active accounts + employee names</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">q / department filters; read-only for Finance</FONT></TD></TR></TABLE>>];
write [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">POST / PATCH / DELETE PDA</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Dean or PDA Manager only</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">POST: existing employee; open account</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Reopen only closed, uncommitted/unspent</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">PATCH: set allocated OR positive top_up</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">DELETE: close, never delete the row</FONT></TD></TR></TABLE>>];
pdalock [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">Financial SQL / locks</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">fn_set_pda_allocation / fn_top_up_pda</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">fn_close_pda; FOR UPDATE PDA lock</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">No lost updates or close/submit race</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Money finite and at most two decimals</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">change_log actor + before/after snapshots</FONT></TD></TR></TABLE>>];
write -> pdalock [label=""];
pdalock -> allocate [label="atomic adjustment", constraint=false];
}
subgraph cluster_directory { label="EMPLOYEE DIRECTORY / ACCESS CONTROL"; style="rounded,filled"; color="#a16207"; fillcolor="#fff0d640"; fontcolor="#a16207"; margin=18;
directory [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">GET / POST employees</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Dean + Finance Admin may read directory</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Dean provisions any canonical role</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Finance Admin creates plain User only</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Initial allocation on create: Dean only</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Employee + optional PDA in one statement</FONT></TD></TR></TABLE>>];
modify [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">PATCH / DELETE employee code</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Dean: role, contacts, department, active</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Finance: contacts; User access changes</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Finance cannot alter privileged</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">role/status/dept</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Reject self-deactivation / own Dean removal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">DELETE means is_active=false</FONT></TD></TR></TABLE>>];
tx [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">actorQueryOne transaction</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">BEGIN -&gt; app.actor_code -&gt; SQL -&gt; COMMIT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">On failure: ROLLBACK on same connection</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Employee-authority advisory lock</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Last active Dean always retained</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Email/department sync to PDA</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Durable employee/PDA before/after log</FONT></TD></TR></TABLE>>];
revoked [label=<<TABLE BORDER="1" COLOR="#a16207" BGCOLOR="#fff0d6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#a16207" POINT-SIZE="16">Next authenticated request</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Active/role reread from employees</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Deactivated employee cannot sign in</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Existing submitted bills continue workflow</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Historical applicant department retained</FONT></TD></TR></TABLE>>];
directory -> tx [label=""];
modify -> tx [label=""];
tx -> revoked [label=""];
}
}
