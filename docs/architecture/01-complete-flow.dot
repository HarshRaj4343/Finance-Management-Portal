digraph architecture {
graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica", fontsize=17, nodesep=0.34, ranksep=0.65, pad=0.25, splines=polyline, compound=true, newrank=true, outputorder=edgesfirst];
node [shape=plain, fontname="Helvetica", fontsize=13];
edge [fontname="Helvetica", fontsize=11, color="#64748b", fontcolor="#334155", arrowsize=0.7, penwidth=1.2];
subgraph cluster_entry { label="ENTRY / TRUSTED IDENTITY"; style="rounded,filled"; color="#a16207"; fillcolor="#fff0d640"; fontcolor="#a16207"; margin=18;
browser [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Browser / login portal</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">React 19 + Next.js 15 App Router</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">HTTPS via institute Nginx proxy</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">/login -&gt; NextAuth credentials</FONT></TD></TR></TABLE>>];
login [label=<<TABLE BORDER="1" COLOR="#a16207" BGCOLOR="#fff0d6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#a16207" POINT-SIZE="16">Identity verification</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">LDAP bind OR retained fixed demo accounts</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Database employee must exist and be active</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Role is read from employees, not the form</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">JWT session: hard 8-hour lifetime</FONT></TD></TR></TABLE>>];
roles [shape=diamond, style=filled, fillcolor="#fff0d6", color="#a16207", fontcolor="#713f12", margin=0.12, label="Live employee\nrole"];
browser -> login [label=""];
login -> roles [label=""];
}
subgraph cluster_landings { label="ROLE LANDING PAGES"; style="rounded,filled"; color="#1d4ed8"; fillcolor="#e5efff40"; fontcolor="#1d4ed8"; margin=18;
user [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">User /user</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Own bills, progress and PDA balance</FONT></TD></TR></TABLE>>];
roles -> user [label=""];
filer [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Bill Employee /apply-bill</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Departmental filing, pending, accepted</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Rejected history + acknowledgement</FONT></TD></TR></TABLE>>];
roles -> filer [label=""];
editor [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Bill Editor /bill-editor</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Departmental bills currently on hold</FONT></TD></TR></TABLE>>];
roles -> editor [label=""];
stores [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Store &amp; Purchase /student-purchase</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Store verification + bank guarantee</FONT></TD></TR></TABLE>>];
roles -> stores [label=""];
auditor [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Audit /audit</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Review bills above Rs 50,000</FONT></TD></TR></TABLE>>];
roles -> auditor [label=""];
finance [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Finance Admin /finance-admin</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Final approval + employee directory</FONT></TD></TR></TABLE>>];
roles -> finance [label=""];
manager [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">PDA Manager /pda-manager</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Open, allocate, top up, close accounts</FONT></TD></TR></TABLE>>];
roles -> manager [label=""];
dean [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Dean /admin</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Provision employees, roles, status, PDA</FONT></TD></TR></TABLE>>];
roles -> dean [label=""];
}
subgraph cluster_purchase { label="TRANSACTIONAL PURCHASE LIFECYCLE"; style="rounded,filled"; color="#6d28d9"; fillcolor="#eee9ff40"; fontcolor="#6d28d9"; margin=18;
form [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Six-step bill wizard</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Submitter -&gt; PO/supplier -&gt; invoice</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Items -&gt; funding/stock -&gt; review</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Delivered + installed when required</FONT></TD></TR></TABLE>>];
submit [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">Validated submission</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">POST /api/bills + retry UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Authorised filer + active applicant/PDA</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Reserve free funds once; log submission</FONT></TD></TR></TABLE>>];
category [shape=diamond, style=filled, fillcolor="#fff0d6", color="#a16207", fontcolor="#713f12", margin=0.12, label="Category?"];
snp [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">Store &amp; Purchase</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Major / Minor only</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Optional validated bank guarantee</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Delivery/installation facts read-only</FONT></TD></TR></TABLE>>];
amount [shape=diamond, style=filled, fillcolor="#fff0d6", color="#a16207", fontcolor="#713f12", margin=0.12, label="Amount >\nRs 50,000?"];
audit [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">Audit verification</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Required strictly above Rs 50,000</FONT></TD></TR></TABLE>>];
fin [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">Finance approval</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">All routes end here</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Current revision + prior approvals</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Applicant/filer cannot decide own bill</FONT></TD></TR></TABLE>>];
accepted [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">Accepted / settled</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Committed -&gt; spent</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">One immutable purchase-register entry</FONT></TD></TR></TABLE>>];
held [label=<<TABLE BORDER="1" COLOR="#92400e" BGCOLOR="#fff5cc" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#92400e" POINT-SIZE="16">Hold / correction loop</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Any active desk + mandatory reason</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Reservation stays; full form corrected</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Amount delta adjusts funds atomically</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Reset approvals/BG; restart category route</FONT></TD></TR></TABLE>>];
rejected [label=<<TABLE BORDER="1" COLOR="#b91c1c" BGCOLOR="#ffe5e5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#b91c1c" POINT-SIZE="16">Rejected / terminal</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Any active desk + mandatory reason</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Committed -&gt; free balance, once</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Acknowledge without money movement</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Refile as a new bill if needed</FONT></TD></TR></TABLE>>];
filer -> form [label="file"];
form -> submit [label=""];
submit -> category [label=""];
category -> snp [label="Major / Minor"];
category -> amount [label="Consumables"];
snp -> amount [label="Approved"];
amount -> audit [label="Yes"];
amount -> fin [label="No"];
audit -> fin [label="Approved"];
fin -> accepted [label="Approved"];
snp -> held [label="Hold", color="#92400e", fontcolor="#92400e", constraint=false];
snp -> rejected [label="Rejected", color="#b91c1c", fontcolor="#b91c1c", constraint=false];
audit -> held [label="Hold", color="#92400e", fontcolor="#92400e", constraint=false];
audit -> rejected [label="Rejected", color="#b91c1c", fontcolor="#b91c1c", constraint=false];
fin -> held [label="Hold", color="#92400e", fontcolor="#92400e", constraint=false];
fin -> rejected [label="Rejected", color="#b91c1c", fontcolor="#b91c1c", constraint=false];
editor -> held [label="correct"];
held -> category [label="resubmit", color="#92400e", fontcolor="#92400e", constraint=false];
stores -> snp [label="desk"];
auditor -> audit [label="desk"];
finance -> fin [label="desk"];
}
subgraph cluster_record { label="RECORDS / READS / NOTIFICATIONS"; style="rounded,filled"; color="#166534"; fillcolor="#dff5e940"; fontcolor="#166534"; margin=18;
pda [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">PDA accounts</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">allocated = free + committed + spent</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Management writes are role-restricted</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Closed accounts retained for history</FONT></TD></TR></TABLE>>];
ledgers [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">PostgreSQL financial records</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">bills + complete form_data + revision</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">bill_approvals: ordered immutable events</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">change_log: immutable before/after</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">purchase_register: final purchases</FONT></TD></TR></TABLE>>];
views [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Authenticated read views</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">/bills -&gt; search/filter all permitted bills</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">/register -&gt; scoped totals + FY filters</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">/bill/[id] -&gt; items, timeline, revisions</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">QR + print: no public data access</FONT></TD></TR></TABLE>>];
mail [label=<<TABLE BORDER="1" COLOR="#0e7490" BGCOLOR="#e4f5f8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#0e7490" POINT-SIZE="16">Notify applicant after commit</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Hold, rejection, final acceptance only</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Gmail/Nodemailer; optional demo redirect</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Failure does not undo the decision</FONT></TD></TR></TABLE>>];
manager -> pda [label=""];
dean -> pda [label=""];
pda -> submit [label="funds", style="dashed", constraint=false];
accepted -> ledgers [label=""];
rejected -> ledgers [label=""];
held -> ledgers [label="", constraint=false];
ledgers -> views [label=""];
views -> user [label="own record", style="dashed", constraint=false];
accepted -> mail [label="outcome", style="dashed", constraint=false];
held -> mail [label="outcome", style="dashed", constraint=false];
rejected -> mail [label="outcome", style="dashed", constraint=false];
}
}
