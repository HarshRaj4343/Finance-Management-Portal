digraph architecture {
graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica", fontsize=17, nodesep=0.34, ranksep=0.65, pad=0.25, splines=polyline, compound=true, newrank=true, outputorder=edgesfirst];
node [shape=plain, fontname="Helvetica", fontsize=13];
edge [fontname="Helvetica", fontsize=11, color="#64748b", fontcolor="#334155", arrowsize=0.7, penwidth=1.2];
department [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">departments</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">PK name: public.department enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">code, is_active, sort_order</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Active lookup list + register serial prefix</FONT></TD></TR></TABLE>>];
employee [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">employees</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">PK id UUID; UNIQUE employee_code</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">UNIQUE upper(employee_code)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">employee_name, email, department</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">employee_type, is_active</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">created_at, updated_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Checks: 8 roles, trimmed IDs/names, email</FONT></TD></TR></TABLE>>];
pda [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">pda_balances</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">PK id UUID; UNIQUE employee_id (FK)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">email, department, is_active</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">allocated, balance, committed, spent</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">numeric(12,2), updated_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Conserved + non-negative + finite checks</FONT></TD></TR></TABLE>>];
bill [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">bills</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">PK id UUID; UNIQUE bill_number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">FK employee_id; employee snapshot name/dept</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">created_by, revision, invoice_no/date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">form_data JSONB; submission_key/hash</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">PO, supplier, items, quantities, fund,</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">location</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">stock_entry; delivery/installation dates</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">has_bank_guarantee + amount/details</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">status; snp/audit/finance_admin; noted</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">remarks + per-desk remarks1..4</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">pda_committed, pda_settled, decided_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">created_at, updated_at</FONT></TD></TR></TABLE>>];
events [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">bill_approvals  [APPEND-ONLY]</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">PK id UUID; FK bill_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">UNIQUE (bill_id, seq)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">stage, action, actor_code/name/role</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">remark, from_status, to_status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">amount, created_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Parent-bill lock serialises event seq</FONT></TD></TR></TABLE>>];
register [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">purchase_register  [APPEND-ONLY]</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">PK id UUID; UNIQUE bill_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">UNIQUE serial_no; financial_year</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">bill_number, entry_date, recorded_at/by</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Department + employee snapshot</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Indenter, items, category, qty</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Supplier/address, amount, fund</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">stock_entry, location</FONT></TD></TR></TABLE>>];
change [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">change_log  [APPEND-ONLY]</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">PK id: generated bigint identity</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">entity, entity_id, operation</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">actor_code; old_data/new_data JSONB</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">recorded_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Tracks bills, employees, pda_balances</FONT></TD></TR></TABLE>>];
counters [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">counters</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">PK scope text; value integer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Locked upsert, transactional increments</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">bill:FY -&gt; IITM/FY/00001</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">reg:DEPT:FY -&gt; DEPT/FY/0001</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Widths expand; FY/dates use IST</FONT></TD></TR></TABLE>>];
employee -> pda [label="1 -> 0..1 FK"];
employee -> bill [label="1 -> many FK"];
bill -> events [label="1 -> many FK"];
bill -> register [label="1 -> 0..1 FK"];
department -> employee [label="enum metadata", style="dashed"];
department -> register [label="code + snapshot", style="dashed"];
counters -> bill [label="bill number", style="dashed"];
counters -> register [label="serial", style="dashed"];
bill -> change [label="trigger snapshot", style="dashed"];
employee -> change [label="trigger snapshot", style="dashed"];
pda -> change [label="trigger snapshot", style="dashed"];
json [label=<<TABLE BORDER="1" COLOR="#475569" BGCOLOR="#f1f5f9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#475569" POINT-SIZE="16">form_data JSONB / item structure</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Requester; PO/direct; supplier/invoice</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Delivery/installation answers and dates</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Category, fund, charges, remarks</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">declaration + totalConfirmed</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">lines[]: key, group, type, brand, model</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">description + descriptionEdited</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">qty, uom, unitPrice, qtyIssued, custodian</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">building, floor, room</FONT></TD></TR></TABLE>>];
constraints [label=<<TABLE BORDER="1" COLOR="#a16207" BGCOLOR="#fff0d6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#a16207" POINT-SIZE="16">Integrity indexes / triggers</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Unique actor + submission_key</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Unique normalised supplier/invoice/invoice FY</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Invoice index excludes Rejected / null legacy</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Revision++ on bill UPDATE; applicant fixed</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Stock ID assigned once and preserved</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Immutable logs; last-Dean guard</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">New constraints NOT VALID preserve legacy</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Indexes: applicant, stage, dates, dept/FY</FONT></TD></TR></TABLE>>];
bill -> json [label="contains", style="dashed"];
bill -> constraints [label="enforced", style="dashed"];
}
