digraph architecture {
graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica", fontsize=17, nodesep=0.34, ranksep=0.65, pad=0.25, splines=polyline, compound=true, newrank=true, outputorder=edgesfirst];
node [shape=plain, fontname="Helvetica", fontsize=13];
edge [fontname="Helvetica", fontsize=11, color="#64748b", fontcolor="#334155", arrowsize=0.7, penwidth=1.2];
review [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Reviewer request</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">POST /api/bills/{id}/action</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Approved / Rejected / Hold</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">expected_revision always required</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Reject/Hold require a reason</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">SNP extra: optional bank guarantee</FONT></TD></TR></TABLE>>];
guards [label=<<TABLE BORDER="1" COLOR="#a16207" BGCOLOR="#fff0d6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#a16207" POINT-SIZE="16">Lock bill + decision guards</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Live active reviewer; owns current desk</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">No accepted/rejected re-decision</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Revision exactly matches reviewed bill</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Neither applicant nor original filer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Prior required desk approvals present</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Different desks use different reviewers</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Active PDA locked for safe settlement</FONT></TD></TR></TABLE>>];
routing [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">Routing after submit / correction</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Major or Minor -&gt; Store &amp; Purchase</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Consumables -&gt; amount-based route</FONT></TD></TR></TABLE>>];
snp [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">Store &amp; Purchase</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Stored status: Student Purchase</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Bank guarantee: positive cents + details</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Delivery/installation facts cannot be changed</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Approved -&gt; amount decision</FONT></TD></TR></TABLE>>];
threshold [shape=diamond, style=filled, fillcolor="#fff0d6", color="#a16207", fontcolor="#713f12", margin=0.12, label="Total >\nRs 50,000?"];
audit [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">Audit</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Review sanction/rates/details</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Approved -&gt; Finance Admin</FONT></TD></TR></TABLE>>];
finance [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">Finance Admin</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Check all required prior approvals</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Approved -&gt; terminal acceptance</FONT></TD></TR></TABLE>>];
accepted [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">Accepted</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">finance_admin=Approved; decided_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">pda_committed=false; pda_settled=true</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Move committed -&gt; spent</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Unique immutable register row</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Approved + Registered events</FONT></TD></TR></TABLE>>];
review -> guards [label=""];
guards -> routing [label="new/corrected route shown", style="dashed"];
routing -> snp [label="Major / Minor"];
routing -> threshold [label="Consumables"];
snp -> threshold [label="Approved"];
threshold -> audit [label="Yes"];
threshold -> finance [label="No"];
audit -> finance [label="Approved"];
finance -> accepted [label="Approved"];
subgraph cluster_hold { label="NON-TERMINAL HOLD / CORRECTION LOOP"; style="rounded,filled"; color="#92400e"; fillcolor="#fff5cc40"; fontcolor="#92400e"; margin=18;
hold [label=<<TABLE BORDER="1" COLOR="#92400e" BGCOLOR="#fff5cc" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#92400e" POINT-SIZE="16">Hold at any current desk</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Mandatory reason + event + revision++</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Desk stays the same; no money movement</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">May be reviewed again without amendment</FONT></TD></TR></TABLE>>];
amend [label=<<TABLE BORDER="1" COLOR="#92400e" BGCOLOR="#fff5cc" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#92400e" POINT-SIZE="16">PATCH /api/bills/{id}</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Full form + expected_revision</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">User-own / Bill Employee / Bill Editor</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Department scope; original applicant fixed</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Current hold required; active PDA locked</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Delta = new total - old total</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Free -= delta; committed += delta</FONT></TD></TR></TABLE>>];
reset [label=<<TABLE BORDER="1" COLOR="#92400e" BGCOLOR="#fff5cc" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#92400e" POINT-SIZE="16">Invalidate and restart</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Before/after bill snapshot retained</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Reset desk approvals + active remarks</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Clear bank guarantee fields</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Preserve original applicant + department</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Preserve bill number / stock / retry identity</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Compute route again; log resubmission</FONT></TD></TR></TABLE>>];
hold -> amend [label="correction"];
amend -> reset [label=""];
reset -> routing [label="restart", color="#92400e", fontcolor="#92400e", constraint=false];
}
subgraph cluster_reject { label="TERMINAL REJECTION / ACKNOWLEDGEMENT"; style="rounded,filled"; color="#b91c1c"; fillcolor="#ffe5e540"; fontcolor="#b91c1c"; margin=18;
reject [label=<<TABLE BORDER="1" COLOR="#b91c1c" BGCOLOR="#ffe5e5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#b91c1c" POINT-SIZE="16">Rejected at any current desk</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Mandatory reason + decided_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Release committed -&gt; free balance once</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">No register entry; no amendment allowed</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Rejected + release events</FONT></TD></TR></TABLE>>];
note [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">POST /api/bills/{id}/note</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Same writer/edit scope; rejected only</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Set noted=true atomically, once</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Acknowledgement event; no money change</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Hide from unacknowledged filing history</FONT></TD></TR></TABLE>>];
refile [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Optional new submission</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">New bill identity and retry UUID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Rejected invoice can be filed again</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">All current validations apply</FONT></TD></TR></TABLE>>];
reject -> note [label=""];
note -> refile [label="if needed", style="dashed"];
}
snp -> hold [label="Hold", color="#92400e", fontcolor="#92400e", constraint=false];
snp -> reject [label="Rejected", color="#b91c1c", fontcolor="#b91c1c", constraint=false];
audit -> hold [label="Hold", color="#92400e", fontcolor="#92400e", constraint=false];
audit -> reject [label="Rejected", color="#b91c1c", fontcolor="#b91c1c", constraint=false];
finance -> hold [label="Hold", color="#92400e", fontcolor="#92400e", constraint=false];
finance -> reject [label="Rejected", color="#b91c1c", fontcolor="#b91c1c", constraint=false];
hold -> guards [label="review current revision", style="dashed", constraint=false];
after [label=<<TABLE BORDER="1" COLOR="#0e7490" BGCOLOR="#e4f5f8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#0e7490" POINT-SIZE="16">After committed outcome</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Hold / reject / accept -&gt; best-effort mail</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Read response -&gt; reviewer UI refresh</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Validation/conflict -&gt; no partial settlement</FONT></TD></TR></TABLE>>];
accepted -> after [label="post-commit", style="dashed", constraint=false];
hold -> after [label="post-commit", style="dashed", constraint=false];
reject -> after [label="post-commit", style="dashed", constraint=false];
}
