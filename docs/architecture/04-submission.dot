digraph architecture {
graph [rankdir=TB, bgcolor="transparent", fontname="Helvetica", fontsize=17, nodesep=0.34, ranksep=0.65, pad=0.25, splines=polyline, compound=true, newrank=true, outputorder=edgesfirst];
node [shape=plain, fontname="Helvetica", fontsize=13];
edge [fontname="Helvetica", fontsize=11, color="#64748b", fontcolor="#334155", arrowsize=0.7, penwidth=1.2];
subgraph cluster_wizard { label="BROWSER - SIX STEPS / UNSENT DRAFT"; style="rounded,filled"; color="#1d4ed8"; fillcolor="#e5efff40"; fontcolor="#1d4ed8"; margin=18;
w1 [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">1  Submitter</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Employee/enrolment code + canonical</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">name</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Debounced lookup after 350 ms</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">/api/lookup/employee?profile=only</FONT></TD></TR></TABLE>>];
w2 [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">2  PO and supplier</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">PO purchase or direct purchase</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">PO number/date/value as applicable</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Supplier name + address; typed inputs</FONT></TD></TR></TABLE>>];
w3 [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">3  Bill / delivery</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Invoice number/date; charges +</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">remarks</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Delivered=yes + delivery date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Installation required? done=yes +</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">date</FONT></TD></TR></TABLE>>];
w4 [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">4  Items</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Major / Minor / Consumables</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Group/type, make/model, description</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Qty, UOM, unit price, issued qty</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Custodian; building/floor/room per</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">line</FONT></TD></TR></TABLE>>];
w5 [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">5  Funding and stock</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Fund code OH-31 or OH-35</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">System stock reference, not paper</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">input</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Preview quantities and derived amount</FONT></TD></TR></TABLE>>];
w6 [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">6  Review</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Full summary and two declarations</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Validate all six steps before sending</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Fingerprint -&gt; crypto.randomUUID key</FONT></TD></TR></TABLE>>];
{rank=same; w1; w2; w3;}
{rank=same; w4; w5; w6;}
w1 -> w2 [label=""];
w2 -> w3 [label=""];
w3 -> w4 [label=""];
w4 -> w5 [label=""];
w5 -> w6 [label=""];
draft [label=<<TABLE BORDER="1" COLOR="#475569" BGCOLOR="#f1f5f9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#475569" POINT-SIZE="16">Draft autosave</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">localStorage per signed-in ID</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Separate new-bill vs bill/revision key</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Clear draft after successful submission</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Not a server record / not a money reserve</FONT></TD></TR></TABLE>>];
draft -> w1 [label="restore", style="dashed", constraint=false];
}
subgraph cluster_api { label="SERVER VALIDATION / AUTHORISATION"; style="rounded,filled"; color="#6d28d9"; fillcolor="#eee9ff40"; fontcolor="#6d28d9"; margin=18;
post [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">POST /api/bills</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">{form_data, submission_key}</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">requireActor -&gt; active live employee</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Validate shapes + caps (2,000 chars)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Valid calendars; no future dates</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Delivered and installed if required</FONT></TD></TR></TABLE>>];
derive [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">Validate + derive payload</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Integer qty 1-999; issued 0..qty</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Recognised item types, UOM and funds</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Money finite, cents, total &lt; Rs 10 billion</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Sum rounded qty x unit price + charges</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Invoice &lt;= PO/direct purchase value</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Canonical active applicant + write scope</FONT></TD></TR></TABLE>>];
w6 -> post [label="same-origin JSON"];
post -> derive [label=""];
}
{rank=same; post; derive;}
subgraph cluster_transaction { label="POSTGRESQL - ONE FINANCIAL TRANSACTION"; style="rounded,filled"; color="#166534"; fillcolor="#dff5e940"; fontcolor="#166534"; margin=18;
sqlguard [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">fn_submit_bill guards</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">fn_assert_bill_writer + fn_validate_bill</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Set transaction-local app.actor_code</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Advisory lock: actor + submission UUID</FONT></TD></TR></TABLE>>];
retry [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">Retry / invoice uniqueness</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Existing key: compare stored MD5 hash</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Same details: return existing bill</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">New key: unique non-rejected invoice</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Normalised supplier + invoice + invoice FY</FONT></TD></TR></TABLE>>];
funds [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">Lock active PDA row</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">FOR UPDATE serialises submissions</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Applicant still active; sufficient free money</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Missing/closed/insufficient -&gt; rollback</FONT></TD></TR></TABLE>>];
insert [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">Internal settlement engine</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Generate IITM/FY/00001 bill number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Route from category + derived amount</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Insert bill: filer, form, invoice, revision=1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Trigger assigns STK/FY/00001 reference</FONT></TD></TR></TABLE>>];
reserve [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">Reserve and log</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Free balance -= amount</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Committed += amount; spent unchanged</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Submitted + System Forwarded events</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Before/after bill and PDA change_log</FONT></TD></TR></TABLE>>];
{rank=same; sqlguard; retry; funds;}
{rank=same; insert; reserve;}
derive -> sqlguard [label=""];
sqlguard -> retry [label=""];
retry -> funds [label="new submission"];
funds -> insert [label=""];
insert -> reserve [label=""];
}
result [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">201 bill response / confirmation</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">ID, number, amount, initial desk</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Refresh dashboard; clear unsent draft</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">API error -&gt; retain editable draft</FONT></TD></TR></TABLE>>];
reserve -> result [label="commit"];
retry -> result [label="same-key replay", style="dashed", constraint=false];
}
