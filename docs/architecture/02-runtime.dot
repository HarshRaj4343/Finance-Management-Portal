digraph architecture {
graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica", fontsize=17, nodesep=0.34, ranksep=0.65, pad=0.25, splines=polyline, compound=true, newrank=true, outputorder=edgesfirst];
node [shape=plain, fontname="Helvetica", fontsize=13];
edge [fontname="Helvetica", fontsize=11, color="#64748b", fontcolor="#334155", arrowsize=0.7, penwidth=1.2];
client [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">User device / browser</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">React pages + NextAuth SessionProvider</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Same-origin JSON requests</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">localStorage holds unsent form drafts</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">No database credentials</FONT></TD></TR></TABLE>>];
subgraph cluster_host { label="INSTITUTE HOST / COMPOSE NETWORK"; style="rounded,filled"; color="#475569"; fillcolor="#f1f5f940"; fontcolor="#475569"; margin=18;
proxy [label=<<TABLE BORDER="1" COLOR="#0e7490" BGCOLOR="#e4f5f8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#0e7490" POINT-SIZE="16">Nginx 1.27 / proxy</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Host PORTAL_PORT (default 8116)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">TLS 1.2 / 1.3; HTTP/2</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Read-only institute certificate + key</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Forward Host / HTTPS / IP headers</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">10 MB body limit; 60 s read timeout</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Buffering off; upgrade forwarding</FONT></TD></TR></TABLE>>];
subgraph cluster_app { label="NEXT-APP CONTAINER - UNPRIVILEGED NODE USER"; style="rounded,filled"; color="#6d28d9"; fillcolor="#eee9ff40"; fontcolor="#6d28d9"; margin=18;
next [label=<<TABLE BORDER="1" COLOR="#1d4ed8" BGCOLOR="#e5efff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1d4ed8" POINT-SIZE="16">Node 22 / Next.js 15.5.25</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">React 19 + NextAuth v4</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Standalone server.js on private :3000</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Static bundles + client page shells</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Dynamic root and Node route handlers</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">No published application port</FONT></TD></TR></TABLE>>];
server [label=<<TABLE BORDER="1" COLOR="#6d28d9" BGCOLOR="#eee9ff" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#6d28d9" POINT-SIZE="16">Server-only application modules</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">auth-options / session / employee</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">bill-validation / notify / http</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">db: shared pg Pool, default max 10</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">30 s idle connection timeout</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Parameterised SQL; transaction helpers</FONT></TD></TR></TABLE>>];
env [label=<<TABLE BORDER="1" COLOR="#a16207" BGCOLOR="#fff0d6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#a16207" POINT-SIZE="16">Runtime server configuration</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">DATABASE_URL / POSTGRES_PASSWORD</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">NEXTAUTH_URL / NEXTAUTH_SECRET</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">LDAP_URL / LDAP_BASE_DN / OU</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">DEMO_LOGIN_ENABLED / DEMO_PASSWORD</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">EMAIL / EMAIL_PASSWORD / MAIL_ENABLED</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">MAIL_REDIRECT_TO; no secrets in diagrams</FONT></TD></TR></TABLE>>];
headers [label=<<TABLE BORDER="1" COLOR="#a16207" BGCOLOR="#fff0d6" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#a16207" POINT-SIZE="16">Response security policy</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">CSP self-only; frames/objects denied</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Production: no unsafe-eval</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Inline scripts/styles still allowed</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">HSTS; nosniff; DENY framing</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Same-origin referrer; restricted sensors</FONT></TD></TR></TABLE>>];
next -> server [label=""];
env -> server [label="runtime", style="dashed"];
headers -> next [label="all responses", style="dashed"];
}
postgres [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">PostgreSQL 17 / db</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Private :5432; no host-published port</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Tables, constraints, locks and functions</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">One transactional financial authority</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Health: pg_isready</FONT></TD></TR></TABLE>>];
volume [label=<<TABLE BORDER="1" COLOR="#166534" BGCOLOR="#dff5e9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#166534" POINT-SIZE="16">Persistent pgdata volume</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Financial state survives restarts</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Fresh volume: migrations 0001 -&gt; 0004</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Existing volume: additive upgrade only</FONT></TD></TR></TABLE>>];
client -> proxy [label="HTTPS :8116"];
proxy -> next [label="HTTP next-app:3000"];
server -> postgres [label="pg / SQL"];
postgres -> volume [label="persistent data"];
}
ldap [label=<<TABLE BORDER="1" COLOR="#0e7490" BGCOLOR="#e4f5f8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#0e7490" POINT-SIZE="16">Institute LDAP directory</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">OU bind over configured LDAP URL</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Reachability requires institute network</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">No local employee password store</FONT></TD></TR></TABLE>>];
smtp [label=<<TABLE BORDER="1" COLOR="#0e7490" BGCOLOR="#e4f5f8" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#0e7490" POINT-SIZE="16">Gmail SMTP via Nodemailer</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Configured sender + app password</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Best-effort post-decision mail</FONT></TD></TR></TABLE>>];
backup [label=<<TABLE BORDER="1" COLOR="#475569" BGCOLOR="#f1f5f9" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#475569" POINT-SIZE="16">Administrator / backups</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Scheduled compressed SQL dump</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Custom-format pre-upgrade dump</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1e293b" POINT-SIZE="13">Protect + copy off host; test restores</FONT></TD></TR></TABLE>>];
server -> ldap [label="credentials", style="dashed"];
server -> smtp [label="notification", style="dashed"];
postgres -> backup [label="pg_dump", style="dashed"];
}
