# next-auth 4 declares `peerOptional nodemailer@^6.6.5`, which it uses only
# for its Email sign-in provider. This portal signs people in with LDAP
# through the Credentials provider and never loads that code, but it does
# send notification mail -- so it is on nodemailer 10, where the advisories
# against 6.x are fixed.
#
# npm refuses that combination unless told the peer range does not matter.
# Without this, `npm ci` fails inside the Docker build.
legacy-peer-deps=true
